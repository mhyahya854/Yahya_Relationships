{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "People Relationships",
  "version": "1.0.0",
  "identifier": "local.people-relationships.app",
  "build": {
    "beforeDevCommand": "npm --prefix ../../App/Frontend run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../../App/Frontend run build",
    "frontendDist": "../../App/Frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "People Relationships",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
